# Configuration locale optionnelle. start.ps1 charge automatiquement .env.
KEYCLOAK_INTERNAL_URL=http://localhost:8180
KEYCLOAK_REALM=orthophoniste
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/orthophoniste
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/orthophoniste/protocol/openid-connect/certs
KEYCLOAK_ADMIN_CLIENT_ID=orthophoniste-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=local-admin-client-secret
KEYCLOAK_SERVICE_CLIENT_ID=rdv-service
KEYCLOAK_SERVICE_CLIENT_SECRET=local-service-client-secret
# MongoDB : omettre MONGO_URI pour utiliser les trois bases locales par défaut.
EUREKA_URL=http://localhost:8761/eureka
ALLOWED_ORIGINS=http://localhost:5180
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_APPOINTMENT_MAX=20
RATE_LIMIT_APPOINTMENT_WINDOW_SECONDS=3600
CABINET_OPEN_TIME=09:00
CABINET_CLOSE_TIME=17:00
CABINET_SLOT_MINUTES=15
CABINET_MAX_BOOKING_DAYS=180
# Twilio reste désactivé tant que les quatre valeurs ne sont pas configurées.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Docker uniquement : origine de l'application servie par Nginx.
PUBLIC_ORIGIN=http://localhost:8080